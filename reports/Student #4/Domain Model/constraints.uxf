<diagram program="umletino" version="15.1"><zoom_level>10</zoom_level><help_text>Space for diagram notes</help_text><element><id>UMLClass</id><coordinates><x>190</x><y>100</y><w>190</w><h>90</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidShortText
--
+ NotBlank
+ Length(min=1, max=75)
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>460</x><y>100</y><w>190</w><h>90</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidLongText
--
+ NotBlank
+ Length(min=1, max=255)
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>190</x><y>220</y><w>240</w><h>90</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidScore
--
+ NotBlank
+ Pattern(regexp="^[\\w\\-]{5,15}$")
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>460</x><y>220</y><w>370</w><h>100</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidURL
--
+ Length(min=0, max=255)
+Must parse as a valid URI
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>190</x><y>370</y><w>350</w><h>80</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidMoment (past = true)
--
+ NotBlank
+ Date must be set in the past
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>590</x><y>380</y><w>560</w><h>90</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidEmail
--
+ NotBlank
+ Pattern(regexp="^(?=.{1,255}$)[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9-]+.)+[A-Za-z0-9-]+$")
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>700</x><y>60</y><w>370</w><h>130</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidMoney
--
+ amount ∈ [min, max] (inclusive)
+ min/max from @ValidMoney or properties: 
acme.data.money.minimum / acme.data.money.maximum
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>550</x><y>520</y><w>500</w><h>90</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidClaim
--
+ Claim must not be null
+ passengerEmail must be unique across claims (excluding the same claim)
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>210</x><y>520</y><w>240</w><h>100</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidScore
--
+ score ∈ [0.00, 100.00] (inclusive)
+ Integer = 3
+ Fraction = 2
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>550</x><y>640</y><w>520</w><h>110</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidAssistanceAgent
--
+ AssistanceAgent must not be null
+ employeeCode format: 2–3 uppercase letters followed by 6 digits (^[A-Z]{2,3}\d{6}$)
+ employeeCode must be unique across assistance agents (excluding the same record)
+ employeeCode first letter = first letter of name; second letter = first letter of surname
bg=RED</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>10</x><y>660</y><w>520</w><h>130</h></coordinates><panel_attributes>&lt;&lt;Constraint&gt;&gt;
ValidTrackingLog
--
+ TrackingLog must not be null
+ If resolutionPercentage = 100 → indicator ∈ {ACCEPTED, REJECTED}
+ If resolutionPercentage &lt; 100 → indicator = PENDING
+ resolutionPercentage must be strictly increasing over time
+ If indicator ≠ PENDING → resolution is required (non-blank)
bg=RED</panel_attributes><additional_attributes></additional_attributes></element></diagram>